{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "NeroNotes - multiloader build (Fabric).",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "accessWidener": "neronotes.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.neronotes.fabric.NeroNotesFabric"],
    "client": ["za.co.neroland.neronotes.fabric.NeroNotesFabricClient"]
  },
  "mixins": [
    "neronotes-common.mixins.json",
    "neronotes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
